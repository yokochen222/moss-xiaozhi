{
    "manufacturer": "moss",
    "type": "moss-onvif",
    "target": "esp32s3",
    "builds": [
        {
            "name": "moss-onvif",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_ENABLE_VAD_INTERRUPT=y",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=n",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SR_MN_CN_NONE=n",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"mo si\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"MOSS\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/moss-desktop-16m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y"
            ]
        }
    ]
}
